# FaceTrack REST API - Environment Configuration Example

# PostgreSQL (Neon) Database Credentials
DB_HOST=ep-empty-violet-avfujn71.c-11.us-east-1.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=your_neon_db_password
DB_SSLMODE=require

# Alternatively, set full DATABASE_URL connection string:
# DATABASE_URL=postgresql://neondb_owner:your_password@ep-empty-violet-avfujn71.c-11.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Authentication Secret Key
JWT_SECRET=facetrack_jwt_secret_neon_2026_production_secure_key

# Frontend Allowed Origin for CORS
ALLOWED_ORIGIN=https://facetrack.vercel.app
